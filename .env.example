# ATC Tracker — Credentials Template
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram → copy the token it gives you
# 2. Message @userinfobot on Telegram → it replies with your numeric chat ID
# 3. Send /start to your new bot at least once so it can message you
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord ───────────────────────────────────────────────────────────────────
# Full walkthrough in DISCORD.md. Summary:
# 1. Create an application + bot at https://discord.com/developers/applications
# 2. Bot tab → copy the token
# 3. OAuth2 → URL Generator: scope "bot", permissions "View Channel",
#    "Send Messages", "Embed Links", "Read Message History" — open the
#    generated URL to invite the bot to your server. Embed Links is easy to
#    miss and required — almost every message this bot sends is an embed.
# 4. Create one text channel per station below, plus #alerts and #commands
#    (make #commands private — deny @everyone View Channel, allow the bot)
# 5. Enable Developer Mode (User Settings → Advanced) then right-click each
#    channel → Copy Channel ID
DISCORD_BOT_TOKEN=
DISCORD_ALERTS_CHANNEL_ID=
DISCORD_COMMANDS_CHANNEL_ID=
DISCORD_CHANNEL_YBCG=
# Gold Coast Ground 121.800 / Tower 118.700 — the aerodrome's own frequencies,
# separate from DISCORD_CHANNEL_YBCG above (which is Brisbane Centre sector).
DISCORD_CHANNEL_YBCG_TWR=
DISCORD_CHANNEL_YSPT=
DISCORD_CHANNEL_YBBN=

# ── Stream URL overrides ───────────────────────────────────────────────────────
# Optional, and normally unnecessary. By default each station connects through
# LiveATC's redirector (http://d.liveatc.net/<mount>), which resolves to
# whichever edge host is currently serving the mount — so ordinary edge
# rotation no longer breaks a feed. Set STREAM_URL_<ICAO> only to pin a
# specific URL. A pinned URL disables the automatic edge fallback.
# (A Discord /seturl override takes precedence over this while it's active.)
STREAM_URL_YBCG=
STREAM_URL_YBCG_TWR=
STREAM_URL_YSPT=
STREAM_URL_YBBN=

# ── Speech-to-text ────────────────────────────────────────────────────────────
# "whisper"  — mlx-whisper large-v3-turbo (default)
# "parakeet" — NVIDIA Parakeet TDT 0.6B v3 via parakeet-mlx
# Compare them on your own recorded audio with: venv/bin/python bench_stt.py
STT_BACKEND=whisper

# ── Recording ─────────────────────────────────────────────────────────────────
# Each transmission is saved to recordings/YYYY-MM-DD/<ICAO>_<HHMMSS>.wav.
# Set to 0 to disable. Recordings older than the retention window are pruned
# at startup.
RECORDING_ENABLED=1
RECORDING_RETENTION_DAYS=14

# ── Military callsign detection ───────────────────────────────────────────────
# Every transcript is checked against a local register of ADF callsigns scraped
# from swld.com.au, so "Falcon one one" is flagged as a 6 SQN Growler without
# being in KEYWORDS_INTEREST. Set to 0 to turn the whole feature off.
MILITARY_DETECTION_ENABLED=1
# Hours between scrapes of the source page.
MILITARY_REFRESH_HOURS=24
# How readily a misheard callsign counts (0-1, higher is stricter).
MILITARY_MIN_CONFIDENCE=0.70

# ── Live ADS-B aircraft tracking ──────────────────────────────────────────────
# Tracks what is actually in the air around the Gold Coast, as opposed to what
# is being said on the radio: military and airshow display aircraft, the
# offshore display box, and YBCG arrivals and departures.
#
# Data comes from adsb.fi — free, no API key, no signup. Two conditions come
# with that, both handled in code: a 1 request/second limit (this polls once
# every 10s) and mandatory attribution, which appears on the pinned board and
# every alert. Personal, non-commercial use only. adsb.lol is the automatic
# failover if adsb.fi is unreachable.
#
# Create two Discord channels and paste their IDs below. Tracking stays off
# until at least one of them is set.
#   #mil-tracker — military + display aircraft, transponder on/off, display box
#   #gc-flights  — Gold Coast Airport arrivals and departures
ADSB_ENABLED=1
DISCORD_CHANNEL_MILITARY=
DISCORD_CHANNEL_FLIGHTS=

# How much civil traffic reaches #gc-flights. YBCG is busy with training and
# scenic helicopter work, which is noise on all but the loudest setting.
#   airline  — airline movements, military, and anything anomalous (default)
#   mil_only — nothing civil at all
#   all      — every ADS-B contact using YBCG
ADSB_CIVIL_REPORTING=airline

# Suppress non-emergency ADS-B alerts overnight, e.g. 22:00-06:00 (Brisbane
# time). The pinned board keeps updating. Empty means never quiet.
ADSB_QUIET_HOURS=

# Always alert on these, whatever the classifier decides. Comma-separated.
# Also settable at runtime with /watch and /unwatch.
ADSB_WATCH_HEX=
ADSB_WATCH_CALLSIGN=

# --- Everything below has a sensible default; set it only to tune. ---
#
# Area of interest. 60 nm from YBCG reaches RAAF Amberley, where the heavy
# military transits into a Gold Coast airshow come from.
# ADSB_HOME_LAT=-28.1644
# ADSB_HOME_LON=153.5047
# ADSB_RADIUS_NM=60
#
# Airshow display box — the offshore strip between Narrowneck and Broadbeach.
# "lat_min,lat_max,lon_min,lon_max", or set ADSB_BOX_POLYGON to
# "lat,lon;lat,lon;..." for a non-rectangular area (the polygon wins).
# ADSB_BOX_BBOX=-28.06,-27.94,153.42,153.52
# ADSB_BOX_POLYGON=
#
# Alert sensitivity. Confidence combines several weak signals, so raising this
# means "require more corroboration"; 0.60 is one strong signal on its own.
# ADSB_MIL_CONFIDENCE=0.60
# ADSB_ALERT_MIN_CONFIDENCE=0.60
#
# Anti-noise thresholds. Aircraft over water drop in and out of receiver
# coverage constantly, and these exist so that does not become an alert storm.
# Raise ADSB_LOST_SEC first if transponder-off alerts are too chatty.
# ADSB_LOST_SEC=120
# ADSB_APPEAR_GAP_MIN=30
# ADSB_EVENT_COOLDOWN_SEC=600
# ADSB_MAX_ALERTS_PER_MIN=12
# ADSB_POLL_SEC=10

# ── ADS-B map (read-only web dashboard) ───────────────────────────────────────
# A live map of everything being tracked, served by this process. Off by
# default.
#
# The startup banner, the terminal log, and the #commands channel all print
# the exact URLs this ends up reachable on.
ADSB_WEB_ENABLED=1
# "tailscale" listens on this host's Tailnet address AND loopback, and
# nothing else. Or give a literal address; 0.0.0.0 exposes it everywhere.
ADSB_WEB_BIND=tailscale
ADSB_WEB_PORT=8099
# Optional shared secret; when set, the page needs ?token=... to load.
ADSB_WEB_TOKEN=

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required to download Whisper models (free account is fine).
# 1. Sign up at https://huggingface.co
# 2. Go to https://huggingface.co/settings/tokens
# 3. Create a token (read-only access is sufficient)
HUGGINGFACE_TOKEN=
